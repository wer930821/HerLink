{
  "expo": {
    "name": "HerLink 後台",
    "slug": "herlink-admin",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "herlinkadmin",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wer93.herlinkadmin"
    },
    "android": {
      "package": "com.wer93.herlinkadmin",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/admin-icon.png",
        "backgroundColor": "#11110f"
      }
    },
    "plugins": [],
    "extra": {
      "adminUrl": "https://her-link-kivora3.vercel.app/admin"
    },
    "icon": "./assets/admin-icon.png"
  }
}
